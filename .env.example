# Container image to run. Pin this to a release tag for predictable upgrades.
PILA_IMAGE=ghcr.io/johanneskast/pila:latest

# PostgreSQL password (use a strong random password in production)
POSTGRES_PASSWORD=change_me

# Only needed for local dev (not used by docker-compose)
# DATABASE_URL=postgres://pila:change_me@localhost:6432/pila_db

# Signal notifications (optional — leave SIGNAL_FROM_NUMBER/SIGNAL_GROUP_ID
# unset to disable). The signal-cli-rest-api container must be linked to your
# Signal account first.
SIGNAL_API_URL=http://signal-cli:8080
SIGNAL_FROM_NUMBER=
SIGNAL_GROUP_ID=

# Public URL of the Pila app, used in notification message links.
BASE_URL=https://pila.example.com

# RSS/Atom news feed shown in the hero ticker on the index page.
# Items older than 72h are filtered out. Leave empty to hide the ticker.
RSS_FEED_URL=

# SMTP configuration for email delivery (optional — leave empty to disable).
# If all five vars are set, Pila sends magic-link invites and tip reminders
# via email. Otherwise email delivery is skipped and only the magic link
# is shown for manual sharing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
