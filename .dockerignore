# ---------------------------------------------------------------------------
# .dockerignore – keep the build context lean and prevent secrets from
# leaking into the Docker image.  Everything listed here is invisible to
# `COPY . .` in the Dockerfile.
# ---------------------------------------------------------------------------

# Secrets & environment
.env
.env.*

# Git metadata
.git
.gitignore
.gitattributes

# Build artefacts (Rust)
target/

# Database dumps & backups
backups/
*.dump
*.sql.gz

# Operational scripts (not needed at compile-time)
*.sh

# Docker / Compose files (not needed inside the image)
Dockerfile
docker-compose*.yml
.dockerignore

# Documentation, handoff notes, CI config
*.md
doc/
handoff/
.claude/

# Tests (not compiled in release mode)
tests/

# IDE / editor droppings
.idea/
.vscode/
*.swp
*.swo
*~