  "db_name": "PostgreSQL",
  "query": "\n            SELECT u.name,\n                   m.stage as \"stage: Stage\",\n                   m.kickoff_time,\n                   m.status,\n                   m.score_home as \"score_home?\",\n                   m.score_away as \"score_away?\",\n                   p.predicted_home,\n                   p.predicted_away\n            FROM predictions p\n            JOIN users u ON u.id = p.user_id\n            JOIN matches m ON m.id = p.match_id\n            ",
