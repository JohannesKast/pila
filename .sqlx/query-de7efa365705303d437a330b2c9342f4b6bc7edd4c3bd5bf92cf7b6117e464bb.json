  "query": "\n                SELECT u.name as user_name, sp.champion_id, t.name as \"team_name?\", t.flag_code\n                FROM special_predictions sp\n                JOIN users u ON u.id = sp.user_id\n                LEFT JOIN teams t ON t.id = sp.champion_id\n                ORDER BY u.name\n                ",
